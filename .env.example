# Copy this file to .env and replace the placeholders before starting.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

POSTGRES_DB=knowledge_agent
POSTGRES_USER=knowledge_agent
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+psycopg://knowledge_agent:change-this-database-password@postgres:5432/knowledge_agent

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_FILES_ONLY=false
MIN_RETRIEVAL_SCORE=0.35
MIN_LEXICAL_COVERAGE=0.18
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=20971520
JOB_STALE_SECONDS=900
JOB_RECOVERY_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
